# Pinned toolchain inputs for the hermetic Smaug build.
#
# Sourced by the Makefile and passed to `docker build` as --build-arg. Keeping
# them here (not scattered in CI YAML) makes the toolchain a single reviewable
# unit and the diff obvious when a pin moves.
#
# For a fully reproducible build, pin BASE_REF to a digest and the EMP refs to
# commit SHAs; the tags below are the fetch convenience defaults. The build
# always records the *resolved* SHAs into toolchain.lock regardless.

# Base OS image. Prefer a digest: ubuntu@sha256:<...>
BASE_REF=ubuntu:24.04

# LLVM major version (Smaug's vendored vectorizer targets 18).
LLVM_VERSION=18

# EMP toolkit (moving tags; resolved SHAs captured in toolchain.lock).
EMP_TOOL_REF=0.3.x
EMP_OT_REF=0.3.x
EMP_SH2PC_REF=0.3.x
EMP_ABY_REPO=https://github.com/radhika1601/ScalableMixedModeMPC.git
EMP_ABY_BRANCH=no-open-fhe

# Fix embedded build timestamps for reproducibility.
SOURCE_DATE_EPOCH=0
